# Web API
PORT=3000
FILTER_GENAI=true
SCRAPE_DELAY=900
PINTEREST_COOKIE=

# Supabase API-key storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Generate separate random values of at least 32 bytes.
# Keep PINSCRAP_KEY_HASH_SECRET unchanged or existing API keys will stop working.
PINSCRAP_ADMIN_KEY=replace-with-a-long-random-admin-secret
PINSCRAP_KEY_HASH_SECRET=replace-with-a-different-long-random-hash-secret

# MCP client (optional when running the web API only)
PINSCRAP_API_KEY=
PINSCRAP_URL=http://localhost:3000
PINSCRAP_TIMEOUT_MS=90000
PINSCRAP_MCP_RATE_LIMIT=30
